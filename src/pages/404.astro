---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Página não encontrada" description="Esta página não existe ou mudou de endereço." noindex>
  <PageHero
    eyebrow="Erro 404"
    title="Esta página não existe ou mudou de endereço."
    lead="Volte para o início ou veja os serviços."
    crumbs={[{ name: 'Página não encontrada', href: '/404' }]}
  >
    <div class="actions">
      <Button href="/">Ir para o início</Button>
      <Button href="/servicos" variant="outline">Ver serviços</Button>
    </div>
  </PageHero>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
