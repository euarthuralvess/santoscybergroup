---
/**
 * Clients as an endless slide. The list is repeated so the track is always
 * wider than the viewport; only the first copy is exposed to screen readers.
 * Pauses on hover; static under prefers-reduced-motion.
 */
import { clients } from '../../data/site';
const copies = 4;
const code = (country: string) => (country === 'Portugal' ? 'PT' : 'BR');
---

<div class="marquee" role="region" aria-label="Clientes atendidos">
  <p class="marquee__label">Clientes atendidos</p>
  <div class="marquee__viewport">
    <div class="marquee__track" style={`--copies: ${copies}`}>
      {
        Array.from({ length: copies }, (_, k) => (
          <ul role="list" aria-hidden={k > 0 ? 'true' : undefined}>
            {clients.map((c) => (
              <li>
                <span class="name">{c.name}</span>
                <span class="country">{code(c.country)}</span>
                <svg class="sep" viewBox="0 0 32 36" aria-hidden="true">
                  <path d="M16 1.2 L30.2 5.6 V20.2 L16 34.8 L1.8 20.2 V5.6 Z" />
                </svg>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  .marquee {
    position: relative;
    display: flex;
    align-items: center;
    gap: 40px;
    padding-block: 30px 36px;
    border-top: 1px solid var(--line-soft);
  }
  .marquee__label {
    flex: none;
    max-width: 13ch;
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--muted);
  }
  .marquee__viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
  }
  ul {
    display: flex;
    align-items: center;
    flex: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-right: 44px;
    white-space: nowrap;
  }
  .name {
    font-family: var(--display);
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgb(232 236 248 / 0.62);
    transition: color var(--dur) var(--ease);
  }
  li:hover .name {
    color: #fff;
  }
  .country {
    padding: 2px 6px;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .sep {
    width: 10px;
    margin-left: 34px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      animation: marquee 38s linear infinite;
    }
    .marquee:hover .marquee__track {
      animation-play-state: paused;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-100% / var(--copies)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track ul[aria-hidden] {
      display: none;
    }
    .marquee__track ul {
      flex-wrap: wrap;
      row-gap: 12px;
    }
  }
  @media (max-width: 980px) {
    .marquee {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
    }
    .marquee__label {
      max-width: none;
    }
  }
</style>
