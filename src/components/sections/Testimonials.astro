---
import { testimonials } from '../../data/site';
const [main, ...rest] = testimonials;
---

<section class="section bg-canvas divide" aria-labelledby="t-title">
  <div class="wrap grid">
    <div class="main">
      <h2 class="title-2xl" id="t-title">O que dizem os clientes</h2>
      <svg class="quote-mark" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4 1.5 12 0l1.5 3C9 4.5 7 7.5 7 11h6v13H0Zm19 0V14c0-8 4-12.5 12-14l1.5 3C28 4.5 26 7.5 26 11h6v13H19Z" /></svg>
      <figure>
        <blockquote>
          <p>{main.quote}</p>
        </blockquote>
        <figcaption>
          <span>
            <strong>{main.name}</strong>
            <span class="muted">{[main.role, main.company].filter(Boolean).join(', ')}</span>
          </span>
        </figcaption>
      </figure>
    </div>
    <div class="side">
      {
        rest.map((t) => (
          <figure>
            <blockquote>
              <p>{t.quote}</p>
            </blockquote>
            <figcaption>
              <span>
                <strong>{t.name}</strong>
                <span class="muted">{[t.role, t.company].filter(Boolean).join(', ')}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
      <p class="muted small">Atendimento remoto, com clientes no Brasil e em Portugal.</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 48px clamp(40px, 7vw, 112px);
    align-items: start;
  }
  .quote-mark {
    width: 30px;
    margin: 18px 0 28px;
    fill: var(--accent);
  }
  .main blockquote {
    font-family: var(--display);
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem);
    font-weight: 300;
    line-height: 1.38;
    letter-spacing: -0.015em;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
  }
  figcaption > span:last-child {
    display: flex;
    flex-direction: column;
    font-size: var(--fs-sm);
  }
  .side figure {
    padding-block: 28px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .side blockquote {
    color: var(--ink-2);
  }
  .small {
    margin-top: 24px;
    font-size: var(--fs-sm);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
