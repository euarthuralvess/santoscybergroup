---
/** Trainings and education as a plain register: issuer, training, year. */
import { founder } from '../../data/site';
---

<section class="section bg-night-2 divide" aria-labelledby="cred-title">
  <div class="wrap grid">
    <div>
      <h2 id="cred-title" class="title-3xl">Formação e credenciais</h2>
      <p class="lead">
        Treinamentos oficiais nas plataformas que protegem grandes empresas, e pós-graduação em cibersegurança na UFRN.
      </p>
    </div>
    <table>
      <caption class="sr-only">Treinamentos e formação de {founder.name}</caption>
      <thead>
        <tr>
          <th scope="col">Emissor</th>
          <th scope="col">Treinamento</th>
          <th scope="col">Ano</th>
        </tr>
      </thead>
      <tbody>
        {
          founder.credentials.map((c) => (
            <tr>
              <td class="issuer">{c.issuer}</td>
              <td>
                {c.name}
                {c.official && <span class="tag">treinamento oficial</span>}
              </td>
              <td class="year">{c.year}</td>
            </tr>
          ))
        }
        {
          founder.education.map((e) => (
            <tr>
              <td class="issuer">{e.school || 'Graduação'}</td>
              <td>{e.name}</td>
              <td class="year">{e.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 40px clamp(40px, 6vw, 88px);
    align-items: start;
  }
  .lead {
    margin-top: 18px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  th {
    padding: 0 12px 12px 0;
    text-align: left;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
    border-bottom: 1px solid var(--line-strong);
  }
  td {
    padding: 14px 12px 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    vertical-align: top;
  }
  .issuer {
    color: var(--ink);
    font-weight: 500;
    white-space: nowrap;
  }
  .year {
    color: var(--muted);
    white-space: nowrap;
  }
  .tag {
    display: inline-block;
    margin-left: 8px;
    font-size: var(--fs-xs);
    color: var(--accent);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
