---
/**
 * First page of the Sentinela monthly report, drawn as a sheet of paper.
 * The service sells a report a director reads, not a dashboard, so the hero
 * shows that. Values are a model, stated in the page footer like a real
 * document would.
 */
import Shield from '../ui/Shield.astro';
import { founder } from '../../data/site';

const done = [
  { text: 'Acesso remoto fechado para a internet', state: 'Resolvido' },
  { text: 'Duas etapas ativadas no e-mail da diretoria', state: 'Resolvido' },
  { text: 'Contas de ex-funcionários removidas do ERP', state: 'Em andamento' },
];
---

<figure class="sheets" aria-label="Modelo da primeira página do relatório mensal do Sentinela PME">
  <div class="sheet sheet--back" aria-hidden="true"></div>
  <div class="sheet sheet--front">
    <header class="doc-head">
      <span class="brand"><Shield size={18} /> Santos Cyber Group</span>
      <span class="meta">Relatório mensal · outubro</span>
    </header>

    <p class="kicker">Sentinela PME</p>
    <p class="title">Resumo para a diretoria</p>

    <div class="score">
      <div>
        <span class="score__n">38<small>/56</small></span>
        <span class="score__l">controles essenciais em dia</span>
      </div>
      <div class="score__delta">+7 desde setembro</div>
    </div>
    <div class="track" aria-hidden="true"><span></span></div>

    <p class="sec">O que mudou no mês</p>
    <ul>
      {
        done.map((d) => (
          <li>
            <span>{d.text}</span>
            <span class:list={['state', { 'state--wip': d.state !== 'Resolvido' }]}>{d.state}</span>
          </li>
        ))
      }
    </ul>

    <p class="sec">Decisão pedida à diretoria</p>
    <p class="decision">Aprovar a cópia de segurança fora do escritório até o fim de novembro.</p>

    <footer class="doc-foot">
      <span class="sign">{founder.name}<em>Responsável técnico</em></span>
      <span class="page">Modelo · página 1 de 2</span>
    </footer>
  </div>
</figure>

<style>
  .sheets {
    position: relative;
    max-width: 460px;
    margin-left: auto;
    padding: 18px 0 18px 18px;
  }
  .sheet {
    border-radius: 6px;
    background: #f7f8fb;
    color: #141b33;
  }
  .sheet--back {
    position: absolute;
    inset: 0 18px 30px 36px;
    transform: rotate(4deg);
    background: #dfe4ef;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6);
  }
  .sheet--front {
    position: relative;
    padding: 26px 28px 22px;
    transform: rotate(-1.5deg);
    box-shadow:
      0 40px 80px -24px rgb(0 0 0 / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.5) inset;
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .doc-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid #d9deea;
    font-size: 0.6875rem;
    color: #5b647f;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.75rem;
    color: #141b33;
  }
  .kicker {
    margin-top: 18px;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #2e55e6;
  }
  .title {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .score {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 16px;
  }
  .score > div:first-child {
    display: flex;
    flex-direction: column;
  }
  .score__n {
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .score__n small {
    font-size: 0.875rem;
    color: #8a92ab;
    letter-spacing: 0;
  }
  .score__l {
    margin-top: 4px;
    font-size: 0.75rem;
    color: #5b647f;
  }
  .score__delta {
    font-size: 0.75rem;
    font-weight: 600;
    color: #13804f;
  }
  .track {
    height: 4px;
    margin-top: 10px;
    border-radius: 4px;
    background: #e1e6f0;
  }
  .track span {
    display: block;
    width: 68%;
    height: 100%;
    border-radius: inherit;
    background: #2e55e6;
  }
  .sec {
    margin-top: 18px;
    padding-bottom: 6px;
    border-bottom: 1px solid #e1e6f0;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #5b647f;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 7px;
    border-bottom: 1px solid #eef1f6;
  }
  .state {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #13804f;
  }
  .state--wip {
    color: #a15c00;
  }
  .decision {
    margin-top: 8px;
  }
  .doc-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px solid #d9deea;
    font-size: 0.6875rem;
    color: #8a92ab;
  }
  .sign {
    display: flex;
    flex-direction: column;
    font-weight: 600;
    color: #141b33;
  }
  .sign em {
    font-style: normal;
    font-weight: 400;
    color: #8a92ab;
  }
  @media (prefers-reduced-motion: no-preference) {
    .track span {
      animation: grow 1.4s var(--ease) 1.1s both;
    }
  }
  @keyframes grow {
    from {
      width: 57%;
    }
  }
  @media (max-width: 560px) {
    .sheets {
      padding-left: 0;
    }
    .sheet--front {
      padding: 22px 20px 18px;
      transform: none;
    }
    .sheet--back {
      display: none;
    }
  }
</style>
