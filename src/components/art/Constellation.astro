---
interface Props {
  count?: number;
  bias?: number;
  seed?: number;
  class?: string;
}
const { count = 110, bias = 0.55, seed = 7, class: className } = Astro.props;
---

<canvas class:list={['constellation', className]} data-constellation data-count={count} data-bias={bias} data-seed={seed} aria-hidden="true"></canvas>

<script src="../../scripts/constellation.ts"></script>

<style>
  .constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
