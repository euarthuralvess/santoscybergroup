---
import Shield from './Shield.astro';
interface Props {
  size?: number;
}
const { size = 38 } = Astro.props;
---

<span class="logo">
  <Shield size={size} />
  <span class="logo__text">
    <span class="logo__name">Santos Cyber Group</span>
    <span class="logo__sub">Cibersegurança para PMEs</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .logo__name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .logo__sub {
    margin-top: 3px;
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
