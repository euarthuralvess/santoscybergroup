---
/** Status pill used inside the illustrative mockups. */
interface Props {
  tone?: 'alert' | 'ok' | 'info' | 'danger' | 'neutral';
}
const { tone = 'neutral' } = Astro.props;
---

<span class:list={['status', `status--${tone}`]}><slot /></span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: var(--pill);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
  }
  .status--alert {
    background: var(--alert-tint);
    color: var(--alert);
  }
  .status--ok {
    background: var(--ok-tint);
    color: var(--ok);
  }
  .status--info {
    background: var(--accent-tint);
    color: var(--accent);
  }
  .status--danger {
    background: var(--danger-tint);
    color: var(--danger);
  }
  .status--neutral {
    background: rgb(255 255 255 / 0.05);
    color: var(--muted);
    border: 1px solid var(--line);
  }
</style>
